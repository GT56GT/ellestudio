# Ellie Studio configuration. Copy to .env and fill in.

# Required ------------------------------------------------------------------
# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Standard Cartesia key (sk_car_...) from https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Access control (strongly recommended) --------------------------------------
# Comma-separated Telegram user IDs allowed to use the bot. Empty = anyone.
# Message the bot once; if you're not allowed it replies with your ID.
ALLOWED_USER_IDS=
# Users who may clone/localize/rename/delete voices and create dictionaries.
# Empty = every allowed user.
ADMIN_USER_IDS=

# Optional -------------------------------------------------------------------
# Admin key (sk_car_admin_...) enables /usage. Never put it in CARTESIA_API_KEY.
CARTESIA_ADMIN_KEY=
# Voice used until a user picks one. Empty = first feminine English voice.
DEFAULT_VOICE_ID=
# sonic-3.6 | sonic-3.5 | sonic-3 | sonic-latest
DEFAULT_MODEL=sonic-3.6
# Max characters per synthesis request (protects credits).
MAX_TTS_CHARS=1500
# Simultaneous Cartesia calls. Match your plan's TTS limit: Free 2, Pro 3, Startup 5, Scale 15.
CARTESIA_CONCURRENCY=2
# Where per-user settings are stored.
DATA_DIR=data
