# Ellie Studio configuration. Copy to .env and fill in.

# Required ------------------------------------------------------------------
# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Standard Cartesia key (sk_car_...) from https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Access control (strongly recommended) --------------------------------------
# Comma-separated Telegram user IDs allowed to use the bot. Empty = anyone.
# Message the bot once; if you're not allowed it replies with your ID.
ALLOWED_USER_IDS=
# Users who may clone/localize/rename/delete voices and create dictionaries.
# Empty = every allowed user.
ADMIN_USER_IDS=

# Optional -------------------------------------------------------------------
# Admin key (sk_car_admin_...) enables /usage. Never put it in CARTESIA_API_KEY.
CARTESIA_ADMIN_KEY=
# Voice used until a user picks one. Empty = first feminine English voice.
DEFAULT_VOICE_ID=
# sonic-3.6 | sonic-3.5 | sonic-3 | sonic-latest
DEFAULT_MODEL=sonic-3.6
# Max characters per synthesis request (protects credits).
MAX_TTS_CHARS=1500
# Daily allowance per user (UTC day). Admins are exempt. 0 = unlimited.
DAILY_CHAR_LIMIT=2000
DAILY_TRANSCRIBE_MINUTES=10
# New voices (clones + localizations) per user per day.
DAILY_VOICE_CREATIONS=3
# New pronunciation dictionaries per user per day.
DAILY_DICTIONARIES=5
# Simultaneous Cartesia calls. Match your plan's TTS limit: Free 2, Pro 3, Startup 5, Scale 15.
CARTESIA_CONCURRENCY=2
# Where per-user settings are stored. Set DATABASE_URL to use Postgres
# (recommended in production; on Render use the Internal connection string).
# Otherwise they go to DATA_DIR/settings.json, owners.json and chats.json.
DATABASE_URL=
DATA_DIR=data

# Groups. Who may add the bot: open (anyone), admins (ADMIN_USER_IDS only) or off.
GROUP_MODE=open
# Shared daily allowance per group, and for all groups together (UTC day,
# on top of each member's own allowance). Admins are exempt. 0 = unlimited.
GROUP_DAILY_CHAR_LIMIT=5000
GROUP_DAILY_TRANSCRIBE_MINUTES=30
GROUPS_TOTAL_DAILY_CHAR_LIMIT=50000
GROUPS_TOTAL_DAILY_TRANSCRIBE_MINUTES=120
# Seconds each member waits between requests in a group, and jobs at once per group.
GROUP_COOLDOWN_SECONDS=10
GROUP_CONCURRENCY=2
# Seconds before short group notices (hints, cooldowns, refusals) delete themselves. 0 keeps them.
GROUP_NOTICE_SECONDS=45
# Guest mode (turn it on in BotFather): chat where readings are briefly
# uploaded to get a file id. Empty = the lowest ADMIN_USER_IDS entry.
GUEST_STORAGE_CHAT_ID=
